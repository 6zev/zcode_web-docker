worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 2048;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  server_tokens off;
  log_format brief '$remote_addr "$request" $status ${request_time}s';
  access_log /var/log/nginx/access.log brief;

  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;

  # WebSocket:有 Upgrade 头就 upgrade,否则 close
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # 简单限速,主要挡暴力破解。
  # 注意:浏览器打开页面会并发拉几十个资源,突发值给小了会 503(踩过)。
  # 想调就改 ZCODE_RATE / ZCODE_BURST;要彻底关掉就把 ZCODE_RATE 设得很大。
  limit_req_zone $binary_remote_addr zone=zcode:10m rate=${ZCODE_RATE};

  # 上游用变量 + resolver(Docker 内置 DNS 127.0.0.11):
  # 这样域名在"请求时"才解析,上游容器晚启动/重建都不会让网关启动失败。
  # (upstream 块是启动期解析,上游没起来会让整个网关起不来。)
  resolver 127.0.0.11 valid=10s ipv6=off;

  server {
    listen ${ZCODE_LISTEN_PORT};
    server_name _;

    set $zcode_upstream "${ZCODE_UPSTREAM}";

    # 需要 HTTPS:挂载证书并打开下面三行(同时把容器端口映射到 443)
    # listen 443 ssl;
    # ssl_certificate /certs/fullchain.pem;
    # ssl_certificate_key /certs/privkey.pem;

    client_max_body_size 512m;
    limit_req zone=zcode burst=${ZCODE_BURST} nodelay;

    # ---- 访问保护:整个站点都要口令(含 /ws) ----
    auth_basic "${ZCODE_AUTH_REALM}";
    auth_basic_user_file /etc/nginx/htpasswd;

    location / {
      # 变量形式需要自己拼 URI(含 query)
      proxy_pass http://$zcode_upstream$request_uri;
      proxy_http_version 1.1;

      # WebSocket / SSE 透传
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;

      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;

      # 长连接 + 不缓冲流式输出
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
  }
}
