# ZCode 网关(反向代理 + 访问保护)
#
#   caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
#
# 作用:默认只暴露网关端口,容器里的 zcode 不再对外发布;所有请求(含 WebSocket /ws)
# 必须先过 Basic Auth 才会被转发到 zcode。
#
# 环境变量:
#   ZCODE_LISTEN    监听地址,默认 :80(容器内)
#   ZCODE_UPSTREAM  上游,默认 zcode:3030(compose 服务名)
#   ZCODE_AUTH_USER Basic Auth 用户名,默认 zcode
#   ZCODE_AUTH_HASH 口令哈希。默认值对应口令 `zcode`,上线前务必改掉:
#                     docker run --rm caddy caddy hash-password --plaintext '你的口令'
#                     把输出的 bcrypt 串直接填进来,或 base64 -w0 后填(两种都支持)
#                   注意:必须用 bcrypt(caddy hash-password),sha512-crypt 不认。
#   ZCODE_TLS       可选 TLS 指令,留空 = 只跑 HTTP(适合放在 nginx/Cloudflare Tunnel 后面):
#                     ZCODE_TLS="tls internal"          自签证书(局域网/本机,浏览器会警告)
#                     ZCODE_TLS="tls you@example.com"   公网域名自动签发 Let's Encrypt
#                  用真实 TLS 时把 ZCODE_LISTEN 改成 :443 并把端口映射到 443。
{
  admin off
  auto_https disable_redirects
}

{$ZCODE_LISTEN::80} {
  {$ZCODE_TLS:}

  # 先认证,再放行;WebSocket 升级请求同样要过这一关
  basic_auth * {
    # 默认口令 `zcode`:请用 ZCODE_AUTH_HASH 覆盖
    {$ZCODE_AUTH_USER:zcode} {$ZCODE_AUTH_HASH:JDJhJDE0JDVyb2RMMnlUa0RpY2k5NVljUlpNYS5NWll0aWljTWZqS0YvU2R6eVhrdDIxdkZzWnlFTVJP}
  }

  reverse_proxy {$ZCODE_UPSTREAM:zcode:3030} {
    header_up Host {upstream_hostport}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    # WebSocket / SSE:不缓冲、不设超时
    flush_interval -1
    transport http {
      read_timeout 0
      write_timeout 0
    }
  }

  encode zstd gzip

  log {
    output stdout
    format console
    level INFO
  }
}
