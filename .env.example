# ZCode Web 运行环境（compose 用）
#
#   cp .env.example .env
#   docker compose up -d --build
#   -> http://localhost:3030/

# ---------- 镜像 ----------
IMAGE_NAME=zcode-web
IMAGE_TAG=3.17.2
# 构建时使用的上游与工具链（默认与 mise.toml 对齐）
ZCODE_REPO=https://github.com/zai-org/ZCode.git
ZCODE_REF=main
NODE_BASE_IMAGE=node:24.14.0-bookworm
PNPM_VERSION=10.33.2
# 国内/网络受限环境可换源
NPM_REGISTRY=https://registry.npmjs.org/

# ---------- 运行时 ----------
ZCODE_PORT=3030
# 宿主机监听地址与端口（0.0.0.0 = 局域网可访问）
BIND_HOST=0.0.0.0
BIND_PORT=3030

# 必填：宿主机上作为“工作目录”的绝对路径
WORKSPACE_DIR=./workspace

# 可选：访问令牌。设置了之后浏览器需先访问
#   http://<host>:3030/?token=<值>
# 换取 Cookie，之后 /api 与 /ws 才放行（改令牌即全部失效）。
# ZCODE_SERVER_AUTH_TOKEN=

# 可选：容器出网代理（访问 zcode.z.ai / api.z.ai / open.bigmodel.cn 不通时用）
# HTTP_PROXY=
# HTTPS_PROXY=

# 可选：时区
TZ=Asia/Saigon

# ---------- 运行身份 ----------
# 镜像默认以 root 运行(入口脚本会把挂载目录属主统一改为当前 UID)。
# 想改回非 root:docker run --user 1000:1000,并确保挂载目录属于 1000:1000。
# APP_UID=1000
# APP_GID=1000

# ---------- 网关(反向代理 + 访问保护) ----------
# zcode 的 3030 默认不对外发布,唯一入口是网关(默认 http://<host>:8080)。
GATEWAY_PORT=8080
GATEWAY_BIND_HOST=0.0.0.0
# 网关账号 / 口令。默认 zcode / zcode,上线前务必改掉:
#   改完 docker compose up -d gateway 即可生效(口令在容器启动时现算成 bcrypt 哈希)
GATEWAY_AUTH_USER=zcode
GATEWAY_AUTH_PASSWORD=change-me
# 也可以直接给哈希(容器内 caddy hash-password --plaintext '口令' | base64 -w0):
# GATEWAY_AUTH_HASH=
# TLS(默认关闭,放在 nginx / Cloudflare Tunnel 后面时保持关闭):
# GATEWAY_TLS=tls internal            # 自签,局域网/本机;同时把 GATEWAY_PORT 映射到 443
# GATEWAY_TLS="tls you@example.com"   # 公网域名自动签 Let's Encrypt
