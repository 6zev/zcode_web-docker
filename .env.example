# ZCode Web 运行环境(compose 用)
#
#   cp .env.example .env
#   docker compose up -d --build
#   -> 首次访问 http://localhost:3030/?token=<令牌>

# ---------- 访问令牌(强烈建议设置) ----------
# 生成: openssl rand -hex 24
#   (或 docker compose run --rm --entrypoint sh zcode-web -c 'openssl rand -hex 24')
#
# 作用:/api/* 与 /ws 全部要求令牌;首次访问 http://<host>:3030/?token=<令牌>
# 会换成 HttpOnly Cookie,之后浏览器正常用;令牌一改,旧 Cookie 立即失效。
# 静态页面本身不含数据,拿到页面但没有令牌也调不到任何接口。
# 留空也能启动(方便本机试跑),但容器启动日志会打印醒目警告,端口等于裸奔;
# 真要裸跑请把 BIND_HOST 设成 127.0.0.1,别直接暴露到公网。
ZCODE_SERVER_AUTH_TOKEN=

# ---------- 端口 ----------
# 宿主机监听地址与端口(0.0.0.0 = 局域网可访问;只想本机用就写 127.0.0.1)
BIND_HOST=0.0.0.0
BIND_PORT=3030

# 容器内端口(一般不用改;改了要同步 BIND_PORT 映射)
ZCODE_PORT=3030

# ---------- 工作目录 ----------
# 宿主机上作为“工作目录”的路径(容器内固定挂在 /root/zcode/workspace)
WORKSPACE_DIR=./workspace

# ---------- 镜像 ----------
IMAGE_NAME=zcode-web
IMAGE_TAG=3.17.2
# 构建时使用的上游与工具链(默认与上游 mise.toml 对齐)
ZCODE_REPO=https://github.com/zai-org/ZCode.git
ZCODE_REF=main
NODE_BASE_IMAGE=node:24.14.0-bookworm
PNPM_VERSION=10.33.2
# 网络受限环境可换源
NPM_REGISTRY=https://registry.npmjs.org/

# ---------- 运行身份 ----------
# 镜像默认以 root 运行(入口脚本会把挂载目录属主统一改为当前 UID)。
# 想改回非 root:docker run --user 1000:1000,并确保挂载目录属于 1000:1000。
# APP_UID=1000
# APP_GID=1000

# ---------- 可选网关(默认不启用) ----------
# 只有当你要 TLS 终止 / 统一限速 / 只开一个端口时才需要:
#   docker compose --profile nginx up -d     # nginx(轻)
#   docker compose --profile caddy up -d     # caddy(自动 HTTPS)
# 开着网关时建议把 zcode-web 的 ports 注释掉,避免绕过网关直连 3030。
GATEWAY_PORT=8080
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_AUTH_USER=zcode
GATEWAY_AUTH_PASSWORD=change-me
GATEWAY_RATE=20r/s
GATEWAY_BURST=200
# GATEWAY_AUTH_HASH=            # 直接给 apr1 哈希(否则由口令现算)
# GATEWAY_CADDY_PORT=8081
# GATEWAY_TLS="tls you@example.com"

# ---------- 可选代理(容器出网) ----------
# 访问 zcode.z.ai / api.z.ai / open.bigmodel.cn 不通时用
# HTTP_PROXY=
# HTTPS_PROXY=

# ---------- 其他 ----------
TZ=Asia/Saigon
