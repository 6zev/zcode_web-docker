# ZCode Web 运行环境(compose 用)
#
#   cp .env.example .env
#   docker compose up -d --build
#   -> 首次访问 http://localhost:3030/?token=<令牌>
#
# 镜像始终以 root 运行;访问保护只用 zcode 自带令牌,不使用任何反代/网关容器。

# ---------- 访问令牌(强烈建议设置) ----------
# 生成: openssl rand -hex 24
#   (或 docker compose run --rm --entrypoint sh zcode-web -c 'openssl rand -hex 24')
#
# 作用:/api/* 与 /ws 全部要求令牌;首次访问 http://<host>:3030/?token=<令牌>
# 会换成 HttpOnly Cookie,之后浏览器正常用;令牌一改,旧 Cookie 立即失效。
# 静态页面本身不含数据,拿到页面但没有令牌也调不到任何接口。
# 留空也能启动(方便本机试跑),但容器启动日志会打印醒目警告,端口等于裸奔;
# 真要裸跑请把 BIND_HOST 设成 127.0.0.1,别直接暴露到公网。
ZCODE_SERVER_AUTH_TOKEN=

# ---------- 端口 ----------
# 宿主机监听地址与端口(0.0.0.0 = 局域网可访问;只想本机用就写 127.0.0.1)
BIND_HOST=0.0.0.0
BIND_PORT=3030

# 容器内端口(一般不用改;改了要同步 BIND_PORT 映射)
ZCODE_PORT=3030

# ---------- 工作目录 ----------
# 宿主机上作为“工作目录”的路径(容器内映射到 /root,即 agent 的默认工作区)。
# 数据则用 ZCode 原生默认 ~/.zcode(命名卷 zcode-data,与工作区互不影响)。
WORKSPACE_DIR=./workspace

# ---------- 镜像 ----------
IMAGE_NAME=zcode-web
IMAGE_TAG=3.17.2
# 用 CI 自动构建的镜像并自动跟进新版本(配合 docker compose pull):
# IMAGE_NAME=ghcr.io/6zev/zcode_web_docker
# IMAGE_TAG=latest
# 构建时使用的上游与工具链(默认与上游 mise.toml 对齐)
ZCODE_REPO=https://github.com/zai-org/ZCode.git
ZCODE_REF=main
NODE_BASE_IMAGE=node:24.14.0-bookworm
PNPM_VERSION=10.33.2
# 网络受限环境可换源
NPM_REGISTRY=https://registry.npmjs.org/

# ---------- Python / 浏览器工具链 ----------
# uv 与 Playwright 的固定版本(构建参数)
UV_VERSION=0.13.7
PLAYWRIGHT_VERSION=1.59.1
# Chrome 需要 --no-sandbox 才能以 root 运行;镜像里的 wrapper 已默认加上。
ZCODE_CHROME_NO_SANDBOX=1

# ---------- 可选代理(容器出网) ----------
# 访问 zcode.z.ai / api.z.ai / open.bigmodel.cn 不通时用
# HTTP_PROXY=
# HTTPS_PROXY=

# ---------- 其他 ----------
TZ=Asia/Saigon
